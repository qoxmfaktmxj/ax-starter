{
  "name": "ax-starter",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "start": "node apps/web/.next/standalone/apps/web/server.js",
    "worker": "node --import tsx apps/worker/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture",
    "format:check": "prettier --check --end-of-line auto apps packages scripts tests",
    "lint": "eslint apps packages scripts tests",
    "typecheck": "tsc --noEmit",
    "architecture": "tsx scripts/check-boundaries.ts",
    "test": "vitest run tests/unit",
    "test:integration": "tsx scripts/assert-test-db.ts && pnpm migrate && pnpm seed && vitest run tests/integration --maxWorkers 1",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/drizzle-adapter": "1.7.5",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "better-auth": "1.7.5",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pg-boss": "12.33.0",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.183.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.4",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1"
  }
}
